#include <stdio.h>
int main() {
   int x;
   scanf("%d", &x);
   int isprime = 1; 
   for(int i=2;i<=x;i++) {
   if (x % i == 0) {
      isprime = 0;
    }  
    if (isprime == 1) {
      printf("%d is a prime number\n", x);
      break;
    }   
    else{
    printf("%d is not a prime number\n", x);
    }
    return 0;
}
//素数能被1和它本身整除，不能被其他数整除。